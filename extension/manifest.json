{
  "manifest_version": 3,
  "name": "ReplyPilot",
  "version": "0.1.0",
  "description": "Suggest three replies for the LinkedIn conversation you choose. Copy and send yourself.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReplyPilot"
  },
  "background": {
    "service_worker": "background.js"
  }
}
